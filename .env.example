# Copy to .env and fill in what you need. Real environment variables win over
# anything in this file, so `CONTRACTMAP_RPC_URL=... contractmap scan ...` always
# overrides what is written here.

# JSON-RPC endpoint used by `scan <address>` and `inspect`. `--rpc` takes precedence.
# Provider URLs usually carry an API key in the path; ContractMap redacts it from
# every output, but keep this file out of git anyway.
CONTRACTMAP_RPC_URL=

# Enables the Etherscan v2 provider. Sourcify needs no key and is already on.
ETHERSCAN_API_KEY=

# Turn on Etherscan without a key (useful when testing the provider path).
# CONTRACTMAP_ETHERSCAN=0

# Disable Sourcify lookups (on by default, no key needed).
# CONTRACTMAP_NO_SOURCIFY=1

# Use a mirror or a self-hosted instance when the public one rate-limits.
# SOURCIFY_URL=https://sourcify.dev/server

# Read one specific dotenv file instead of ./.env and ./.env.local.
# CONTRACTMAP_ENV_FILE=/absolute/path/to/contractmap.env

# Budgets. Defaults shown; raise them when a scan warns about a budget.
# CONTRACTMAP_DEPTH=2
# CONTRACTMAP_MAX_NODES=400
# CONTRACTMAP_MAX_REQUESTS=300
# CONTRACTMAP_CONCURRENCY=4

# Show a traceback instead of one actionable line. Bug reports only.
# CONTRACTMAP_DEBUG=1
